@@ -0,0 +1,53 @@
+package io.github.kdroidfilter.seforimlibrary.sefariasqlite
+
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * Sefaria link rows whose one side names the wrong segment, re-anchored to the reviewed
+ * citation before the row is resolved (Otzaria/otzaria#4023). [RESOURCE] holds, per row, the
+ * side that stays ([Correction.keep]), the wrong side exactly as Sefaria exports it
+ * ([Correction.wrong]) and its replacement ([Correction.corrected]), which may be a range: the
+ * importer then writes link_range and link_coverage for it like for any ranged citation.
+ *
+ * Only the exact pair is touched, in either column order. Once Sefaria fixes or moves the row
+ * the pair no longer occurs, nothing changes, and [unused] names the stale correction.
+ */
+internal class SefariaLinkCitationCorrections(private val corrections: List<Correction>) {
+
+    internal data class Correction(val keep: String, val wrong: String, val corrected: String)
+
+    private val byPair: Map<Pair<String, String>, Correction> =
+        corrections.associateBy { it.keep to it.wrong }
+    private val used = ConcurrentHashMap.newKeySet<Correction>()
+
+    /** The row's two normalized citations, with a listed wrong side replaced. */
+    fun apply(c1: String, c2: String): Pair<String, String> {
+        byPair[c1 to c2]?.let { used += it; return c1 to it.corrected }
+        byPair[c2 to c1]?.let { used += it; return it.corrected to c2 }
+        return c1 to c2
+    }
+
+    /** Corrections no row matched: Sefaria changed the row, so the entry should be reviewed. */
+    fun unused(): List<Correction> = corrections.filter { it !in used }
+
+    companion object {
+        const val RESOURCE = "corrected_link_citations.tsv"
+
+        fun load(classLoader: ClassLoader?): List<Correction> {
+            val stream = classLoader?.getResourceAsStream(RESOURCE)
+                ?: throw IllegalStateException("$RESOURCE missing from the sefariasqlite resources")
+            return stream.bufferedReader(Charsets.UTF_8).useLines(::parse)
+        }
+
+        internal fun parse(lines: Sequence<String>): List<Correction> {
+            val entries = lines.filter { it.isNotBlank() && !it.startsWith("#") }.map { row ->
+                val cols = row.split('\t').map(::normalizeCitation)
+                require(cols.size == 3 && cols.none { it.isBlank() }) { "$RESOURCE: expected 3 columns in '$row'" }
+                require(cols[1] != cols[2] && cols[0] != cols[1]) { "$RESOURCE: row changes nothing: '$row'" }
+                Correction(cols[0], cols[1], cols[2])
+            }.toList()
+            require(entries.map { it.keep to it.wrong }.distinct().size == entries.size) { "$RESOURCE: duplicate row" }
+            return entries
+        }
+    }
+}
