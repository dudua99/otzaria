+package io.github.kdroidfilter.seforimlibrary.sefariasqlite
+
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertFailsWith
+import kotlin.test.assertNull
+import kotlin.test.assertTrue
+
+// Otzaria/otzaria#4023: a Sefaria link row whose base side names the wrong segment.
+class SefariaLinkCitationCorrectionsTest {
+
+    private val ramban = SefariaLinkCitationCorrections.Correction(
+        keep = "Chiddushei Ramban on Shabbat 141b:2",
+        wrong = "Shabbat 141b:16",
+        corrected = "Shabbat 141b:28-142a:1",
+    )
+
+    @Test
+    fun `resource holds the reviewed Ramban on Shabbat row`() {
+        val entries = SefariaLinkCitationCorrections.load(SefariaLinkCitationCorrections::class.java.classLoader)
+        assertEquals(listOf(ramban), entries)
+    }
+
+    @Test
+    fun `the wrong side of the exact row is replaced, in either column order`() {
+        val corrections = SefariaLinkCitationCorrections(listOf(ramban))
+        assertEquals(
+            "Chiddushei Ramban on Shabbat 141b:2" to "Shabbat 141b:28-142a:1",
+            corrections.apply("Chiddushei Ramban on Shabbat 141b:2", "Shabbat 141b:16"),
+        )
+        assertEquals(
+            "Shabbat 141b:28-142a:1" to "Chiddushei Ramban on Shabbat 141b:2",
+            corrections.apply("Shabbat 141b:16", "Chiddushei Ramban on Shabbat 141b:2"),
+        )
+        assertTrue(corrections.unused().isEmpty())
+    }
+
+    @Test
+    fun `the corrected side is a range the importer widens with link_range and coverage`() {
+        val range = parseCitationRange(canonicalCitation(ramban.corrected))
+        assertEquals("shabbat 141b:28", range?.startCanonical)
+        assertEquals("shabbat 142a:1", range?.endCanonical)
+    }
+
+    @Test
+    fun `any other row is left alone and an unused correction is reported`() {
+        val corrections = SefariaLinkCitationCorrections(listOf(ramban))
+        for ((c1, c2) in listOf(
+            "Chiddushei Ramban on Shabbat 141b:2" to "Shabbat 141b:17", // Sefaria fixed or moved it
+            "Chiddushei Ramban on Shabbat 141b:3" to "Shabbat 141b:16",
+            "Rashi on Shabbat 141b:16:1" to "Shabbat 141b:16",
+        )) {
+            assertEquals(c1 to c2, corrections.apply(c1, c2))
+        }
+        assertEquals(listOf(ramban), corrections.unused())
+    }
+
+    @Test
+    fun `rejects malformed, self-naming and duplicate rows`() {
+        assertFailsWith<IllegalArgumentException> { SefariaLinkCitationCorrections.parse(sequenceOf("a\tb")) }
+        assertFailsWith<IllegalArgumentException> { SefariaLinkCitationCorrections.parse(sequenceOf("a\tb\t ")) }
+        assertFailsWith<IllegalArgumentException> { SefariaLinkCitationCorrections.parse(sequenceOf("a\tb\tb")) }
+        assertFailsWith<IllegalArgumentException> {
+            SefariaLinkCitationCorrections.parse(sequenceOf("a\tb\tc", "a\tb\td"))
+        }
+        assertNull(SefariaLinkCitationCorrections.parse(sequenceOf("# comment", "")).firstOrNull())
+    }
+}
