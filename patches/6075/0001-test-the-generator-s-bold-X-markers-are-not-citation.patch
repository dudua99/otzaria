+"""The generator's bold "[סעיף X]" division markers are not citations (Otzaria/otzaria#6075, #5927).
+
+SeforimLibrary prints the Shulchan Arukh se'ifim inside the Tur as "<b>[סעיף ה]</b>"
+(SefariaTurSeifMarkers). The NER read "סעיף ה" there as a citation and the ibid history
+supplied a siman: Tur, Orach Chayim 217 got links to Shulchan Arukh, Orach Chayim 79:5-8,
+and 621 of the 623 LINKER links from the Tur to the Shulchan Arukh in v40 were such markers.
+"""
+import os
+import sys
+import types
+import unittest
+
+sys.modules.setdefault("resource", types.SimpleNamespace(
+    getrusage=lambda *_: types.SimpleNamespace(ru_maxrss=0), RUSAGE_SELF=0,
+    getrlimit=lambda *_: (0, 0), setrlimit=lambda *_: None, RLIMIT_AS=0, RLIM_INFINITY=-1,
+))
+
+ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+sys.path.insert(0, os.path.join(ROOT, "src"))
+
+import link_books  # noqa: E402
+
+
+def span(content, text):
+    start = content.index(text)
+    return start, start + len(text)
+
+
+class DivisionMarkerTest(unittest.TestCase):
+
+    def test_a_marker_from_the_tur_is_not_a_citation(self):
+        # Tur, Orach Chayim 217:1 in v40 (the span the NER returned is the label alone).
+        content = 'ברוך אתה ה\' אמ"ה בורא עצי בשמים: <b>[סעיף ה]</b> בשמים של עבודה זרה'
+        self.assertTrue(link_books.inside_division_marker(content, *span(content, "סעיף ה")))
+
+    def test_the_whole_marker_and_a_multi_seif_marker(self):
+        content = "ויברך עליהם <b>[סעיפים ב, ג]</b> ואם"
+        self.assertTrue(link_books.inside_division_marker(content, *span(content, "[סעיפים ב, ג]")))
+        self.assertTrue(link_books.inside_division_marker(content, *span(content, "סעיפים ב")))
+
+    def test_a_span_reaching_past_the_marker_is_a_citation(self):
+        content = "<b>[סעיף ה]</b> וכן כתבתי בסימן קנ\"ח"
+        self.assertFalse(link_books.inside_division_marker(content, *span(content, "סעיף ה]</b> וכן כתבתי בסימן")))
+
+    def test_a_printed_citation_of_a_seif_is_not_a_marker(self):
+        for content, text in [
+            ("ועיין בשולחן ערוך סימן רמג סעיף ב", "סימן רמג סעיף ב"),
+            ("כמו שכתבתי לעיל [סעיף ג] בשם הרא\"ש", "סעיף ג"),  # brackets, but not the bold marker
+            ("<b>סעיף ג</b> כתב", "סעיף ג"),
+        ]:
+            with self.subTest(content=content):
+                self.assertFalse(link_books.inside_division_marker(content, *span(content, text)))
+
+
+if __name__ == "__main__":
+    unittest.main()
