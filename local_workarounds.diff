--- new file core/src/commonMain/kotlin/androidx/compose/runtime/Stable.kt
package androidx.compose.runtime

annotation class Stable
--- ~/.gradle/gradle.properties
org.gradle.jvmargs=-Xmx1536m
kotlin.compiler.execution.strategy=in-process
generatorHeap=8g
linkerHeap=8g
--- ~/.gradle/init.d/mirror.gradle.kts
val mirror = "https://maven-central.storage-download.googleapis.com/maven2/"
fun org.gradle.api.artifacts.dsl.RepositoryHandler.mirrorFirst() {
    maven { name = "gcsCentralMirror"; url = uri(mirror) }
}
beforeSettings {
    pluginManagement.repositories.mirrorFirst()
    pluginManagement.repositories.gradlePluginPortal()
    dependencyResolutionManagement.repositories.mirrorFirst()
}
allprojects {
    buildscript.repositories.mirrorFirst()
    repositories.mirrorFirst()
}
